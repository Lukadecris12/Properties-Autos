# Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL with PostGIS / pgvector, or local SQLite for testing)
POSTGRES_USER=propertyhub_user
POSTGRES_PASSWORD=propertyhub_secure_pwd
POSTGRES_DB=propertyhub_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://propertyhub_user:propertyhub_secure_pwd@localhost:5432/propertyhub_db
SYNC_DATABASE_URL=postgresql://propertyhub_user:propertyhub_secure_pwd@localhost:5432/propertyhub_db

# Redis & Celery
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=propertyhub_development_jwt_secret_key_needs_64_bytes_secure_2026_xxyyzz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS & Frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# AI Provider Configuration
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Google Maps Platform
GOOGLE_MAPS_API_KEY=

# Storage (Local uploads or S3)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-west-1

# External Payments (Paystack / Flutterwave)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
